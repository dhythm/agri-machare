# Auth.js session secret. Required in production (generate with `openssl rand -base64 32`).
# Unset outside production falls back to a fixed development value.
AUTH_SECRET=

# Demo accounts (Auth.js Credentials provider, no user table).
# Unset outside production falls back to admin@example.com / dev-admin,
# seller@example.com / dev-seller, and user@example.com / dev-user.
# In production an unset account is disabled.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=dev-admin
DEMO_SELLER_EMAIL=seller@example.com
DEMO_SELLER_PASSWORD=dev-seller
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=dev-user

# Shared password for the persona accounts (sellers, buyers, carriers in the
# sample data). Unset outside production falls back to dev-persona; in
# production an unset value keeps the personas listed but unable to sign in.
DEMO_PERSONA_PASSWORD=dev-persona

# Set to off to seed only the sample listings and jobs, without the demo
# activity (orders, rentals, threads, reviews, notifications).
DEMO_ACTIVITY=
